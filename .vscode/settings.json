{
  // Hide diagnostics sourced from dependencies (node_modules)
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,
  // Ensure the workspace uses our project tsconfig and not package-internal ones
  "typescript.tsdk": null,
  // Keep TypeScript validation on for our app code
  "typescript.validate.enable": true,
  // Lint only our workspace, not dependencies
  "eslint.workingDirectories": [
    { "mode": "auto" }
  ]
}
