{
  "expo": {
    "name": "Blood Donation App",
  "slug": "blood-donation-app-dev",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "updates": {
      "enabled": false,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_ERROR_RECOVERY"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ]
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.blooddonation.dev"
    },
    
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE-WITH-YOUR-EAS-PROJECT-ID"
      },
      "EXPO_PUBLIC_API_BASE_URL": "http://192.168.1.100:5000",
      "EXPO_PUBLIC_API_TIMEOUT_MS": 15000
    }
  }
}
