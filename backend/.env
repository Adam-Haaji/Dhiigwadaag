# Copy this file to .env and replace each placeholder with your own value.
# Never commit the real .env file or any API keys, passwords, or JWT secrets.

BACKEND_PORT=5000

# MongoDB Atlas connection string.
# URL-encode special characters in the username and password.
MONGO_URI=mongodb+srv://<username>:<url_encoded_password>@<cluster_host>/?retryWrites=true&w=majority&appName=<app_name>

# Used when MONGO_URI does not include a database name in its path.
MONGO_DB_NAME=BloodDonationDB

# Generate a long, random value for production.
JWT_SECRET=<replace_with_a_long_random_secret>

# Local Expo/React Native development URL.
FRONTEND_URL=http://localhost:8081

# Required for the chatbot. Create a key in your OpenAI account.
OPENAI_API_KEY=<your_openai_api_key>

