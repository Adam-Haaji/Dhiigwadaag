# MongoDB connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority
MONGO_DB_NAME=blood-donation
MONGO_AUTH_SOURCE=admin

# Server port (fallback to 4000 if unset)
BACKEND_PORT=5001
# or set PORT=5001

# Matching radius in KM (optional)
MATCH_RADIUS_KM=30
